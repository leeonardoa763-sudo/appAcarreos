{
  "expo": {
    "name": "Control de Acarreos",
    "slug": "control-acarreos",
    "version": "1.2.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F6FA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.controlacarreos.app",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "NSCameraUsageDescription": "Se requiere acceso a la cámara para tomar fotos de los vales.",
        "NSLocationWhenInUseUsageDescription": "Se requiere acceso a la ubicación para registrar el punto de carga y entrega del material.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Se requiere acceso a la ubicación para registrar el punto de carga y entrega del material."
      }
    },
    "android": {
      "versionCode": 28,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B35"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.controlacarreos.app",
      "permissions": [
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH_PRIVILEGED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-file-system",
        {
          "enableAudioRecordings": false,
          "enableVideoRecordings": false
        }
      ],
      "expo-secure-store",

      [
        "expo-camera",
        {
          "cameraPermission": "Se requiere acceso a la cámara para tomar fotos de los vales.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Se requiere acceso a la ubicación para registrar el punto de carga y entrega del material.",
          "locationWhenInUsePermission": "Se requiere acceso a la ubicación para registrar el punto de carga y entrega del material."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "33b24368-32ca-4247-94a6-1055c29eea0f"
      },
